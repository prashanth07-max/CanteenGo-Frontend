# Copy this file to ".env.local" (git-ignored) for local dev, or set it as a
# build-time environment variable in your static host (e.g. Vercel/Netlify) for production.
#
# Backend base URL. Leave EMPTY in development to use the Vite dev proxy ("/api").
# For production set the full backend origin, e.g. https://canteengo-api.onrender.com
VITE_API_URL=
